{
  "compilerOptions": {
    "target": "ES2023",                      
    "module": "esnext",                     
    "moduleResolution": "bundler",             
    
    "rootDir": "src",                          
    "outDir": "./dist",                          
    "strict": true,                             
    "noImplicitAny": true,                       
    "strictNullChecks": true,                   
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,                    
    "skipLibCheck": true,                        
    "forceConsistentCasingInFileNames": true     
  },
  "include": ["src/**/*"],                       
  "exclude": ["node_modules", "dist"]            
}